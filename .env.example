SECRET_KEY=change-this-value
DATABASE_PATH=instance/database.db
TIMEZONE=Asia/Kolkata
DEBUG=True
MAX_CONTENT_LENGTH=2097152

# --- Email reports (optional) ---
# Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=True,
# MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<16-char Google App Password>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
EMAIL_SCHEDULER_ENABLED=True
EMAIL_SEND_HOUR=18
